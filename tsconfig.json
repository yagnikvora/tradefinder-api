{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node"],
    // `npm run build` emits plain ESM here, so a host can run `node dist/index.js`
    // without tsx. Imports already carry .js extensions, which is what Node's ESM
    // loader needs. Development still runs the TypeScript directly.
    "outDir": "dist",
    "rootDir": "src"
  },
  "include": ["src"]
}
