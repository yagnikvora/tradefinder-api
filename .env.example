# Copy to .env. All optional except UPSTOX_ACCESS_TOKEN. A clone with no .env still runs.
# Values shown are the defaults. Longer rationale for any line: git log -p .env.example

# --- Upstox (serves every live figure: quotes, chains, candles, open interest) ---
# Use an ANALYTICS token, not the OAuth access token — the latter expires daily at 03:30 IST.
# https://account.upstox.com/developer/apps -> Analytics -> Generate. A new one revokes the old.
UPSTOX_ACCESS_TOKEN=
UPSTOX_TIMEOUT_MS=8000
# Extra attempts after the first, for timeouts and dropped sockets. 0 disables.
UPSTOX_RETRIES=1

# --- Alerts (empty = off; WHAT gets sent lives in /pullback/config, not here) ---
# @BotFather -> /newbot for the token; message the bot, then read the chat id from
# https://api.telegram.org/bot<TOKEN>/getUpdates. Test: POST /pullback/alerts/test
PULLBACK_TELEGRAM_BOT_TOKEN=
# Telegram REASSIGNS this id if a plain group becomes a supergroup: sends then succeed and
# deliver nothing. Re-read it from getUpdates if a working feed goes silent for no reason.
PULLBACK_TELEGRAM_CHAT_ID=
# Sent IN ADDITION to Telegram, so one channel can fail silently without costing the alert.
# Discord -> Edit Channel -> Integrations -> Webhooks. The URL is a credential.
PULLBACK_DISCORD_WEBHOOK_URL=

# --- Session bells (the 09:15 good morning and the 15:30 session-closed message) ---
# Sent to whichever channels above are configured. `off` silences both; anything else leaves
# them on. Preview either without waiting for the clock:
#   POST /pullback/alerts/test?sample=open    POST /pullback/alerts/test?sample=close
SESSION_BELL=on
# Where each bell's quote comes from. `live` fetches 100 candidates from zenquotes.io per bell
# (free, no key, 4 requests a day) and picks the best fit, so no quote ever repeats; `builtin`
# pins it to the small offline set in alerts/quotes.ts and makes no outbound call. Live falls
# back to the offline set on its own whenever the host is slow, throttled or unreachable — the
# bell always rings. Their free tier is licensed on the credit that sits beside the author name;
# `builtin` is the way to have no credit at all, not deleting it while still using their feed.
SESSION_BELL_QUOTES=live
# NSE holidays, YYYY-MM-DD, comma separated. This is the only way the bells know about a Republic
# Day, because nothing in this codebase holds a holiday calendar. It does TWO things: no bells on
# a listed day, and the closing message points at the next day the market is actually open —
# "Back at 09:15 on Tuesday" when Monday is shut.
#
# WEEKDAY CLOSURES ONLY. The four 2026 holidays that fell at a weekend (Mahashivratri 15 Feb,
# Id-Ul-Fitr 21 Mar, Independence Day 15 Aug, Diwali Laxmi Pujan 8 Nov) are left out because the
# session clock already skips Saturdays and Sundays. That last one carries the Muhurat session,
# which is an evening special and not the 09:15–15:30 day these bells ring for.
#
# REFRESH THIS EVERY JANUARY. NSE publishes the coming year around December, and one-offs are
# added mid-year with days of notice — 15 Jan 2026 was declared on 12 Jan for the Maharashtra
# civic polls, which is why it is missing from most calendar pages. Re-read on every tick, so a
# date added here takes effect without a restart. An empty value still gets weekends right; it
# will just say "tomorrow" on the eve of a holiday.
#
# 2026 (16 weekday closures):
#   Jan 15 Maharashtra civic polls · Jan 26 Republic Day · Mar 3 Holi · Mar 26 Shri Ram Navami
#   Mar 31 Shri Mahavir Jayanti · Apr 3 Good Friday · Apr 14 Ambedkar Jayanti
#   May 1 Maharashtra Day · May 28 Bakri Id · Jun 26 Muharram · Sep 14 Ganesh Chaturthi
#   Oct 2 Gandhi Jayanti · Oct 20 Dussehra · Nov 10 Diwali Balipratipada
#   Nov 24 Guru Nanak Jayanti · Dec 25 Christmas
MARKET_HOLIDAYS=2026-01-15,2026-01-26,2026-03-03,2026-03-26,2026-03-31,2026-04-03,2026-04-14,2026-05-01,2026-05-28,2026-06-26,2026-09-14,2026-10-02,2026-10-20,2026-11-10,2026-11-24,2026-12-25

# --- Scanners ---
# Trailing sessions behind the R.Factor baseline.
RVOL_WINDOW=50
# Background jobs. Set BOTH to off on any replica that is not the writer — two processes
# scanning spend the same token's request budget twice for one board.
MOMENTUM_SCHEDULER=on
PULLBACK_SCHEDULER=on
# Boot-time session rebuild, ~208 candle requests, so the Trend Day board does not depend on
# this process having run since 09:15. Skips symbols it watched from the open.
MOMENTUM_SEED=on

PORT=4100
