# Copy to .env (or set these in your host's environment) — all optional.

# Where the OI tape is stored.
#
# Unset: a JSON file under api/.cache. Fine for one machine, and a fresh clone runs with
# no setup at all.
#
# Set: Postgres. This is what lets the recorder and the web app live on different
# machines — the recorder writes here from wherever it runs, and any API reads from here,
# so the page shows a full session even if the web host was off all day. The table is
# created on first use; there is no migration step.
#
# Managed providers (Supabase, Neon, Railway, RDS) hand you a URL in this shape:
#
# For a plain local server with no TLS, add ?sslmode=disable
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/tradefinder?sslmode=disable

# How many days of OI history to keep. Older trading days are deleted on every recorder
# tick. Default 7.
OI_RETENTION_DAYS=7

# How often the standalone recorder takes a reading, in ms. Default 300000 (5 minutes),
# which matches the tape's slot size — going faster just overwrites the same slot.
RECORD_TICK_MS=300000

# How long to wait on NSE before giving up on a request. Default 8000.
NSE_TIMEOUT_MS=8000

