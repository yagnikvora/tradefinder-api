{
  "name": "tradefinder-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc",
    "typecheck": "tsc -p tsconfig.check.json",
    "start:prod": "node dist/index.js",
    "check-flux": "tsx tools/flux-validate.ts",
    "check-upstox": "tsx tools/upstox-validate.ts",
    "check-momentum": "tsx tools/momentum-validate.ts",
    "check-pullback": "tsx tools/pullback-validate.ts",
    "research-pullback": "tsx tools/pullback-research.ts",
    "demo-alert": "tsx tools/demo-alert.ts",
    "replay-trend": "tsx tools/trend-replay.ts",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0"
  }
}
