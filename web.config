<?xml version="1.0" encoding="UTF-8"?>
<!--
  IIS configuration for running this API under iisnode. Used ONLY on a Windows/Plesk host;
  a Linux deployment (deploy/README.md) ignores this file entirely.

  WHY THIS IS IN THE REPOSITORY. Plesk's Node.js panel writes a web.config into the document
  root, but on this host that file contained only error-page paths and an ASP.NET temp directory
  — no iisnode handler and no rewrite rule. The result is that IIS serves static files and never
  hands a request to Node: `/` returned the placeholder index.html with 200, and every real
  route — /health included — returned 404 from IIS, with the Node process never involved.
  Hand-editing the file in the Plesk code editor does not stick, and would be undone by the next
  Plesk configuration rebuild in any case. Keeping it here means a deploy restores it.

  THE FOUR THINGS THAT MATTER, in the order they bite:

  handlers      Registers iisnode for app.js. Without it there is no path from IIS to Node.

  rewrite       Sends EVERY url to app.js. Express owns its own routing, so IIS must not try to
                match paths against the filesystem — and `defaultDocument` is disabled below so
                a stray index.html cannot shadow the API at `/`.

  iisnode       `nodeProcessCountPerApplication="1"` is the important attribute and it is not a
                performance tuning knob. This app is a SCHEDULER: it builds the baseline at 08:00,
                scans every 15s, and writes a trade to the journal on every alert. Two node
                processes would mean two schedulers on one database — two Telegram messages per
                signal and duplicate journal rows. One process, always.

  httpErrors    existingResponse="PassThrough" stops IIS replacing the API's own JSON error
                bodies with an HTML error page. Without it a 404 from Express arrives at the
                client as Plesk's not_found.html, which no JSON client can read.

  NOT SET HERE, deliberately: the port. iisnode passes a NAMED PIPE in PORT, and src/index.ts
  detects a non-numeric PORT and listens on the pipe. Do not add a numeric PORT to the Plesk
  environment variables — it would win, bind a TCP socket nothing is connected to, and the app
  would log a clean startup while every request 500s.
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="TrinetraApiToNode" stopProcessing="true">
          <match url=".*" />
          <action type="Rewrite" url="app.js" />
        </rule>
      </rules>
    </rewrite>

    <iisnode nodeProcessCountPerApplication="1"
             loggingEnabled="true"
             devErrorsEnabled="true"
             node_env="production" />

    <defaultDocument enabled="false" />

    <httpErrors existingResponse="PassThrough" />

    <security>
      <requestFiltering>
        <!-- The journal edit routes POST a trade object; the default 30MB cap is far more than
             needed, but the explicit small limit makes an oversized body a 413 rather than a
             surprise. -->
        <requestLimits maxAllowedContentLength="2097152" />
        <hiddenSegments>
          <!-- Nothing under these should ever be reachable over HTTP. `.cache` holds the journal
               and the option-path archive; `.env` would be the whole credential set. -->
          <add segment="node_modules" />
          <add segment=".cache" />
          <add segment="deploy" />
          <add segment="src" />
          <add segment="tools" />
          <add segment="test" />
          <add segment="research" />
        </hiddenSegments>
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
